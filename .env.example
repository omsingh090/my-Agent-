# Portfolio runtime configuration
# Copy to .env.local for local development.

# Required for server-side email sending
RESEND_API_KEY=
CONTACT_EMAIL=

# Public site and profile configuration
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_GITHUB_URL=

# International WhatsApp number in digits only (no +, spaces, or punctuation)
# Example: 919999999999
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Public fallback contact display (optional)
NEXT_PUBLIC_CONTACT_EMAIL=

# Resume integration
# Option A: Local public file path, e.g. /resume/om-singh-resume.pdf
NEXT_PUBLIC_RESUME_PATH=
# Option B: Hosted URL (used when local path is empty)
NEXT_PUBLIC_RESUME_URL=

# Optional social preview image URL
NEXT_PUBLIC_OG_IMAGE_URL=
